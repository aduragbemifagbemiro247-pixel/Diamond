# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional cryptographic secrets for admin sessions and payment credential encryption
ADMIN_SESSION_SECRET="change-me-in-production-random-64-chars"
CREDENTIAL_ENCRYPTION_KEY="change-me-in-production-32-byte-hex"
